{
  "name": "@scure/starknet",
  "version": "2.2.0",
  "description": "Audited & minimal implementation of Starknet cryptography including Pedersen and Stark Curve",
  "files": [
    "index.js",
    "index.d.ts",
    "index.ts"
  ],
  "dependencies": {
    "@noble/curves": "~2.3.0",
    "@noble/hashes": "~2.3.0"
  },
  "devDependencies": {
    "@paulmillr/jsbt": "0.6.5",
    "@scure/base": "2.2.0",
    "@scure/bip32": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@types/node": "25.3.0",
    "fast-check": "4.2.0",
    "prettier": "3.6.2",
    "typescript": "6.0.2"
  },
  "scripts": {
    "benchmark:size": "npx bismar@0.1.3 -s",
    "build": "tsc",
    "check": "jsbt-check",
    "benchmark": "cd test/benchmark; npm i; node index.js",
    "format": "prettier --write index.ts test/*.test.ts",
    "test": "node test/index.ts"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "keywords": [
    "starknet",
    "stark curve",
    "pedersen hash",
    "stark key",
    "starkware",
    "starkex",
    "cryptography"
  ],
  "homepage": "https://paulmillr.com/noble/#scure",
  "funding": "https://paulmillr.com/funding/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulmillr/scure-starknet.git"
  },
  "type": "module",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "author": "Paul Miller (https://paulmillr.com)",
  "license": "MIT"
}
